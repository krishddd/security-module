# ============================================================================
#  Template — copy to .env and fill in real values.  Never commit .env.
# ============================================================================
#
# python-dotenv loads .env at CLI startup.
#
# --llm uses one of three providers, chosen with `--llm-provider`
# (default: auto = Anthropic if its key is set, else OpenAI):
#   ANTHROPIC_API_KEY -> Anthropic (Claude) provider.
#   OPENAI_API_KEY    -> OpenAI (GPT) provider.
#   ollama            -> local / air-gapped; NO key. Needs `ollama serve`
#                        running. Select with `--llm-provider ollama`.
# ============================================================================

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# ASI_LLM_MODEL_PLANNER=claude-opus-4-7
# ASI_LLM_MODEL_PAYLOAD=claude-sonnet-4-6
# ASI_LLM_MODEL_TRIAGE=claude-sonnet-4-6
# ASI_MAX_LLM_SPEND_USD=2.00
# ASI_MAX_LLM_CALLS=200

# Ollama (local / air-gapped) — used with `--llm-provider ollama`
# ASI_OLLAMA_BASE_URL=http://localhost:11434
# ASI_OLLAMA_MODEL_PLANNER=llama3.1
# ASI_OLLAMA_MODEL_PAYLOAD=llama3.1
# ASI_OLLAMA_MODEL_TRIAGE=llama3.1

# Auth tokens for agents under test (refer to by name via --auth-env)
# MY_AGENT_TOKEN=
